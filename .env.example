# Copiar a .env.local y completar.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: la usa el cron de avisos. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Web Push. Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Protege el endpoint del cron de avisos
CRON_SECRET=
